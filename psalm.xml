<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <!--
        Suppression configured at psalm.xml level (per §2 php-best-practices.md:
        «Допускается настройка в psalm.xml»).

        Schema::__construct / Schema::withOverrides: deprecated in 1.x via ADR
        `.ai/reports/adr-schema-constructor.md` (task 11b §10). Replaced by
        `Schema::fromConstraintGroups()` / `Schema::withOverrideGroups()`. The
        internal caller of `withOverrides` (CompositionResolver) plus 35+ callers of `__construct`
        are tracked for migration in a follow-up task; suppressing here keeps
        Psalm green during the 1.x deprecation window pending 2.0 removal.
        IDE / runtime `#[Deprecated]` attribute still surfaces the deprecation
        to direct callers via PHPStorm / Intelephense / `E_DEPRECATED`.

        ValidationContext::__construct / ValidationContext::create: deprecated in
        1.x via ADR `.ai/reports/adr-validator-signatures-and-dtos.md` (task 18 §10).
        Replaced by `ValidationContext::fromInit(ValidationContextInit $init)`. The
        16 internal callers of `create()` (ItemsValidator,
        PatternPropertiesValidator, etc.) plus test-suite callers of `__construct`
        are tracked for migration in a follow-up task; suppressing here keeps
        Psalm green during the 1.x deprecation window pending 2.0 removal.
        IDE / runtime still surfaces the deprecation to direct external callers.
    -->
    <issueHandlers>
        <DeprecatedMethod>
            <errorLevel type="suppress">
                <referencedMethod name="Duyler\OpenApi\Schema\Model\Schema::__construct" />
                <referencedMethod name="Duyler\OpenApi\Schema\Model\Schema::withOverrides" />
                <referencedMethod name="Duyler\OpenApi\Validator\Error\ValidationContext::__construct" />
                <referencedMethod name="Duyler\OpenApi\Validator\Error\ValidationContext::create" />
            </errorLevel>
        </DeprecatedMethod>
    </issueHandlers>
</psalm>
